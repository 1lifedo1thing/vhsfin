# Fastlane reads .env from the repository root. Copy to .env (gitignored)
# and fill in locally. Never commit .env, keystores, .p8 keys, or JSON keys.
BUILD_NUMBER=1

# iOS — App Store Connect API key (shared across MarkDid apps)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Android — Play service account (shared) + this app's upload keystore
GOOGLE_PLAY_JSON_KEY=
VHSFIN_ANDROID_KEYSTORE_PATH=
VHSFIN_ANDROID_KEY_ALIAS=
VHSFIN_ANDROID_STORE_PASSWORD=
VHSFIN_ANDROID_KEY_PASSWORD=

